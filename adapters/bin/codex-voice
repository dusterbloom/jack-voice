#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "${SOURCE}" ]; do
  DIR="$(cd -P "$(dirname "${SOURCE}")" >/dev/null 2>&1 && pwd)"
  TARGET_PATH="$(readlink "${SOURCE}")"
  if [[ "${TARGET_PATH}" != /* ]]; then
    SOURCE="${DIR}/${TARGET_PATH}"
  else
    SOURCE="${TARGET_PATH}"
  fi
done

SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"
python3 "${ROOT_DIR}/cli_voice.py" ask --target codex "$@"
